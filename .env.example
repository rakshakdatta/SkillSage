# Copy to .env and fill in what you need. Everything is optional:
# with no key at all SkillSage runs in offline practice mode (rule-based scoring, no AI).

# auto = Gemini if GEMINI_API_KEY is set, else Groq if GROQ_API_KEY is set, else offline
LLM_PROVIDER=auto

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local model (Ollama, llama.cpp or LM Studio). No key, nothing leaves your machine.
# If a Gemini/Groq key is also set, this becomes the BACKUP used when the free API fails or its quota runs out.
# If no key is set, it is used on its own. Leave LOCAL_LLM_MODEL empty to turn it off.
#   1B-3B models (gemma2:2b, llama3.2:3b) need ~4-6 GB free RAM; 7B-8B (llama3.1:8b) need ~8 GB.
#   Ollama:    ollama pull gemma2:2b        -> URL http://127.0.0.1:11434/v1
#   llama.cpp: llama-server -m model.gguf   -> URL http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_TIMEOUT_SECONDS=180

# Accounts and history
# Leave DATABASE_URL empty for a SQLite file in ./instance. For MySQL or PostgreSQL, for example:
#   DATABASE_URL=mysql+pymysql://user:password@localhost/skillsage      (pip install pymysql)
#   DATABASE_URL=postgresql+psycopg://user:password@localhost/skillsage (pip install "psycopg[binary]")
DATABASE_URL=
# Signs the login cookie. Leave empty to generate one automatically (kept in ./instance/.secret_key).
SECRET_KEY=
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
# Sign-in / sign-up attempts allowed per 5 minutes per visitor
AUTH_RATE_LIMIT=10

# Server
PORT=5055
LLM_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=40